generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Severity {
  Low
  Medium
  High
  Critical
}

enum IncidentStatus {
  Open
  Investigating
  Mitigating
  Monitoring
  Resolved
  Closed
}

enum TaskStatus {
  ToDo       @map("To Do")
  InProgress @map("In Progress")
  Done
  Blocked
}

enum Priority {
  Low
  Medium
  High
  Critical
}

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  role      String
  incidents Incident[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("users")
}

model Incident {
  id             String                @id @default(cuid())
  title          String
  type           String
  severity       Severity
  status         IncidentStatus        @default(Open)
  affectedSystem String
  impactSummary  String
  affectedUsers  Int
  rawLogs        String?
  suspectedCause String?
  detectedAt     DateTime
  resolvedAt     DateTime?
  createdBy      String
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  creator     User                  @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  aiReport    IncidentAiReport?
  tasks       IncidentTask[]
  auditTrails IncidentAuditTrail[]

  @@index([createdBy])
  @@index([severity])
  @@index([status])
  @@index([detectedAt])
  @@map("incidents")
}

model IncidentAiReport {
  id                    String   @id @default(cuid())
  incidentId            String   @unique
  riskClassification    Json
  timeline              Json
  checklist             Json
  technicalActionPlan   Json
  stakeholderSummary    String   @db.Text
  postmortemReport      Json
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@map("incident_ai_reports")
}

model IncidentTask {
  id          String     @id @default(cuid())
  incidentId  String
  title       String
  description String?
  owner       String
  status      TaskStatus @default(ToDo)
  priority    Priority
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([status])
  @@index([priority])
  @@map("incident_tasks")
}

model IncidentAuditTrail {
  id         String   @id @default(cuid())
  incidentId String
  action     String
  actor      String
  oldValue   Json?
  newValue   Json?
  note       String?
  createdAt  DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([action])
  @@index([createdAt])
  @@map("incident_audit_trails")
}
